{
  "name": "ai-photography-prompt",
  "version": "0.1.0",
  "private": true,
  "description": "AI 摄影提示词图鉴 — 奖项级视觉的 Next.js + Cloudflare D1 提示词画廊",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cf:build": "npx @cloudflare/next-on-pages",
    "cf:dev": "npx wrangler pages dev .vercel/output/static --d1 DB=./.wrangler/state/v3/d1/DB.sqlite",
    "db:migrate:local": "wrangler d1 execute DB --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute DB --remote --file=./migrations/0001_init.sql",
    "collect": "node scripts/collect.mjs"
  },
  "dependencies": {
    "next": "15.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
